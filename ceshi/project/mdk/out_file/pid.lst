   43          
   44          float PID_Increase(PID *pid, float nowdata, float target)
   45          {
   46   1          float error = target - nowdata;
   47   1          float last_e = pid->lasterror;
   48   1          float last_last_e = pid->lastlasterror;
   49   1          float p_term, i_term, d_term, delta;
   50   1      
   51   1          p_term = pid->Kp * (error - last_e);
   52   1          i_term = pid->Ki * error;
   53   1          d_term = pid->Kd * (error - 2.0f * last_e + last_last_e);
   54   1          delta = p_term + i_term + d_term;
   55   1      
   56   1          pid->Out_put += delta;
