  154          /**
  155           * @brief 解析字符串为浮点数（支持负数、小数）
  156           * @param  str 字符串指针
  157           * @param  end 解析结束位置（输出参数，可为 NULL）
  158           * @return 解析得到的浮点数
  159           */
  160          static float vofa_atof(const uint8 *str, const uint8 **end)
  161          {
  162   1          float  result = 0.0f;
  163   1          float  sign = 1.0f;
  164   1          float  decimal_div = 10.0f;
  165   1          uint8  has_decimal = 0;
  166   1          const uint8 *p = str;
  167   1      
  168   1          // 跳过空格
  169   1          while(*p == ' ' || *p == '\t')
  170   1          {
  171   2              p++;
  172   2          }
  173   1      
  174   1          // 符号
  175   1          if(*p == '-')
  176   1          {
  177   2              sign = -1.0f;
  178   2              p++;
  179   2          }
  180   1          else if(*p == '+')
  181   1          {
  182   2              p++;
  183   2          }
  184   1      
  185   1          // 整数部分和小数部分
  186   1          while(*p != '\0' && *p != '\n' && *p != '\r' && *p != ',' && *p != '}')
  187   1          {
  188   2              if(*p >= '0' && *p <= '9')
C251 COMPILER V5.60.0,  my_vofa                                                            08/11/26  15:04:37  PAGE 4   

  189   2              {
  190   3                  if(has_decimal)
  191   3                  {
  192   4                      result += (float)(*p - '0') / decimal_div;
  193   4                      decimal_div *= 10.0f;
  194   4                  }
  195   3                  else
  196   3                  {
  197   4                      result = result * 10.0f + (float)(*p - '0');
  198   4                  }
  199   3              }
  200   2              else if(*p == '.')
  201   2              {
  202   3                  has_decimal = 1;
  203   3              }
  204   2              else
  205   2              {
  206   3                  break;
  207   3              }
  208   2              p++;
  209   2          }
  210   1      
  211   1          if(end != (const uint8 **)0)
  212   1          {
  213   2              *end = p;
  214   2          }
  215   1      
  216   1          return sign * result;
  217   1      }
