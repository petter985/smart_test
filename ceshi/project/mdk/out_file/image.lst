   70          float get_bird_error_from_right(void)
   71          {
   72   1          uint8 row1 = MT9V03X_H - 37;
   73   1          uint8 row2 = MT9V03X_H - 40;
   74   1          float bird_x1, bird_y1, bird_x2, bird_y2, bird_Mx, bird_My;
   75   1          float dx, dy, len;
   76   1          float normal_x, normal_y;
   77   1          float half_width = BIRD_TRACK_WIDTH / 2.0f;
   78   1          float bird_Cx, bird_Cy;
   79   1      
   80   1          if (r_line_x[row1] == MT9V03X_W - 1 || r_line_x[row2] == MT9V03X_W - 1)
   81   1              return 0.0f;
   82   1      
   83   1          inverse_perspective((float)r_line_x[row1], (float)row1, &bird_x1, &bird_y1);
   84   1          inverse_perspective((float)r_line_x[row2], (float)row2, &bird_x2, &bird_y2);
   85   1          inverse_perspective((float)MID_W, (float)row1, &bird_Mx, &bird_My);
   86   1      
   87   1          dx = bird_x2 - bird_x1;
   88   1          dy = bird_y2 - bird_y1;
