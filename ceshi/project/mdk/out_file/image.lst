   57          void inverse_perspective(float col, float row, float *x, float *y)
   58          {
   59   1          float u, v, w;
   60   1          u = change_un_Mat[0][0] * col + change_un_Mat[0][1] * row + change_un_Mat[0][2];
   61   1          v = change_un_Mat[1][0] * col + change_un_Mat[1][1] * row + change_un_Mat[1][2];
   62   1          w = change_un_Mat[2][0] * col + change_un_Mat[2][1] * row + change_un_Mat[2][2];
   63   1          *x = u / w;
   64   1          *y = v / w;
   65   1      }
