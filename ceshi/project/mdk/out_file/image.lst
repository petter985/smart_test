   91   1      
   92   1          normal_x = -dy / len;
   93   1          normal_y =  dx / len;
   94   1      
   95   1          bird_Cx = bird_x1 - half_width * normal_x;
   96   1          bird_Cy = bird_y1 - half_width * normal_y;
   97   1      
   98   1          return (bird_Cx - bird_Mx) * normal_x + (bird_Cy - bird_My) * normal_y;
   99   1      }
